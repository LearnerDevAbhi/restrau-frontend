# Public API origin. Leave empty in development: Vite proxies /api to the server,
# which also makes phone testing over Wi-Fi work without CORS changes.
# In production set it to the API origin, e.g. https://api.yourrestaurant.com
VITE_API_URL=

# Dev only: where the Vite proxy forwards /api
VITE_DEV_API_PROXY=http://localhost:5050
